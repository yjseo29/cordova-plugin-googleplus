<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-googleplus"
        version="10.1.0">

  <name>Google SignIn</name>

  <description>Use your Google account to authenticate with the app.</description>

  <author>Eddy Verbruggen</author>

  <license>MIT</license>

  <keywords>Google, Google SignIn, GoogleSignIn, Google Login, Login, OAuth, Identity, Authentication</keywords>

  <repo>https://github.com/yjseo29/cordova-plugin-googleplus.git</repo>

  <issue>https://github.com/yjseo29/cordova-plugin-googleplus/issues</issue>

  <!-- ⚠️ cordova-android 하한이 6.3.0 이었는데 실제 코드와 맞지 않았다.
       src/android/GooglePlus.java 가 androidx.activity 의 ActivityResultLauncher /
       registerForActivityResult 를 쓰므로 AndroidX + cordova-android 10 이상이어야 한다.
       6.x 에 설치하면 설치는 되고 컴파일에서 깨진다. -->
  <engines>
    <engine name="cordova" version=">=9.0.0"/>
    <engine name="cordova-android" version=">=10.0.0"/>
  </engines>

  <js-module src="www/GooglePlus.js" name="GooglePlus">
    <clobbers target="window.plugins.googleplus" />
  </js-module>

  <!-- android -->
  <platform name="android">

    <!-- ⚠️ play-services-identity 는 제거했다. 선언만 있고 GooglePlus.java 의 import 는 0 개였다.
         (구형 Address API 용이라 Google Sign-In 과 무관하다) -->
    <preference name="PLAY_SERVICES_AUTH_VERSION" default="21.6.0"/>
    <framework src="com.google.android.gms:play-services-auth:$PLAY_SERVICES_AUTH_VERSION" />

    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="GooglePlus">
        <param name="android-package" value="nl.xservices.plugins.GooglePlus" />
        <param name="onload" value="true" />
      </feature>
      <access origin="https://accounts.google.com/*" />
    </config-file>

    <!-- ⚠️ GET_ACCOUNTS / USE_CREDENTIALS 는 제거했다.
         AccountManager 로 계정을 직접 읽던 시절의 잔재이고, 지금 Google Sign-In 은
         Google Play services 를 거치므로 둘 다 필요 없다.
         USE_CREDENTIALS 는 API 23 에서 플랫폼에서 아예 삭제된 권한이고,
         GET_ACCOUNTS 는 위험 권한이라 남겨두면 런타임 권한 요청 대상이 되고
         Play Console 권한 설문에도 걸린다. -->

    <source-file src="src/android/GooglePlus.java" target-dir="src/nl/xservices/plugins"/>
  </platform>

  <!-- ios -->
  <platform name="ios">

    <config-file target="config.xml" parent="/*">
      <feature name="GooglePlus">
        <param name="ios-package" value="GooglePlus"/>
        <param name="onload" value="true" />
      </feature>
      <access origin="https://accounts.google.com/*" />
    </config-file>

    <header-file src="src/ios/GooglePlus.h"/>
    <source-file src="src/ios/GooglePlus.m"/>
          
    <preference name="REVERSED_CLIENT_ID" />
    <preference name="CLIENT_ID" />

    <config-file target="*-Info.plist" parent="GIDClientID">
      <string>$CLIENT_ID</string>
    </config-file>

    <config-file target="*-Info.plist" parent="CFBundleURLTypes">
      <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>REVERSED_CLIENT_ID</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>$REVERSED_CLIENT_ID</string>
            </array>
        </dict>
      </array>
    </config-file>
          

    <config-file parent="keychain-access-groups" target="*/Entitlements-Debug.plist">
      <array>
        <string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
      </array>
    </config-file>
    <config-file parent="keychain-access-groups" target="*/Entitlements-Release.plist">
      <array>
        <string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
      </array>
    </config-file>

    <!-- System frameworks -->
    <!-- ⚠️ AddressBook.framework 와 libz.dylib 는 제거했다.
         AddressBook 은 iOS 9 에서 deprecated 된 연락처 API 로 Google Sign-In 과 무관한데,
         링크해두면 Apple 의 privacy manifest 심사에서 연락처 접근 사유를 요구받을 수 있다.
         libz.dylib 는 Xcode 7 이후 .tbd 로 대체되어 존재하지 않는다(바로 아래 .tbd 가 정본). -->
    <framework src="CoreText.framework" weak="true" />
    <framework src="SafariServices.framework" weak="true" />
    <framework src="Security.framework" weak="true" />
    <framework src="SystemConfiguration.framework" weak="true" />
    <framework src="libz.tbd" weak="true" />

    <!-- Google frameworks -->
    <preference name="GOOGLE_SIGN_IN_VERSION" default="~> 7.1.0"/>
    <preference name="GOOGLE_UTILITIES_VERSION" default="~> 8.0"/>
    <podspec>
      <config>
        <source url="https://cdn.cocoapods.org/"/>
      </config>
      <pods use-frameworks="true">
        <pod name="GoogleSignIn" spec="$GOOGLE_SIGN_IN_VERSION"/>
        <pod name="GoogleUtilities" spec="$GOOGLE_UTILITIES_VERSION"/>
      </pods>
    </podspec>

    <!-- ⚠️ iOS 훅 두 개를 모두 제거했다(hooks/ios/ 디렉터리도 함께 삭제).
         - after_prepare.js : 프로젝트 루트의 GoogleService-Info.plist(Firebase 설정)에서
           CLIENT_ID 를 읽어 Info.plist 의 GIDClientID 에 써넣던 훅이다. Firebase 를 쓰지 않는
           프로젝트에는 그 파일이 없어 deferral.reject 로 prepare 자체가 실패했다.
           위의 <preference name="CLIENT_ID"> + <config-file parent="GIDClientID"> 선언이
           같은 일을 Firebase 없이 처리하므로 대체가 끝났다.
         - prerequisites.js : 위 훅이 쓰던 xcode / plist npm 패키지를 설치하려고
           npm install 을 돌리던 훅이다. 쓰는 쪽이 사라져 목적이 없어졌고,
           require('q') 가 cordova 12 에 번들되지 않아 설치가 깨질 위험만 남았다. -->
  </platform>

  <!-- browser -->
  <platform name="browser">
    <js-module src="src/browser/GooglePlusProxy.js" name="GooglePlusProxy">
      <clobbers target="GooglePlus" />
    </js-module>
    <config-file target="config.xml" parent="/*">
      <feature name="GooglePlus">
        <param name="onload" value="true" />
      </feature>
      <access origin="https://accounts.google.com/*" />
    </config-file>

    <preference name="WEB_APPLICATION_CLIENT_ID" />

    <!-- after_prepare hook to populate APP_ID -->
    <hook type="after_prepare" src="hooks/browser/after_prepare.js" />
  </platform>

</plugin>
